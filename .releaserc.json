{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/npm", { "pkgRoot": "packages/pet" }],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "npm publish ./packages/pet --ignore-scripts --registry=https://npm.pkg.github.com --//npm.pkg.github.com/:_authToken=$GITHUB_TOKEN"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["packages/pet/package.json", "package-lock.json"],
        "message": "chore(release): v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
